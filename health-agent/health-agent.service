[Unit]
Description=Local health agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/health-agent.py
Environment=HEALTH_PORT=14159
Environment=HEALTH_PROCESS=necesse
Environment=HEALTH_MODE=
Environment=SERVICE_URL=
Restart=always
User=nobody
AmbientCapabilities=CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_SYS_PTRACE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
